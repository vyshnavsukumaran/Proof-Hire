# Postgres connection (Supabase). URL-encode special chars in the password.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres?sslmode=require

# Optional: isolate app tables in a dedicated schema.
DB_SCHEMA=proofhire

# Supabase project (Dashboard -> Settings -> API)
SUPABASE_URL=https://YOUR_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Storage bucket used for avatar / project images.
STORAGE_BUCKET=uploads
